# Copia este fichero a .env y cambia las contraseñas:  cp .env.example .env
# Consejo: usa contraseñas sin espacios, comillas ni el símbolo $

MYSQL_DATABASE=zero_doubt
MYSQL_USER=zero_doubt_user
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_password_root

# Puerto web (http://localhost:8080)
WEB_PORT=8080
# Puerto local para conectar un cliente SQL a MySQL (solo 127.0.0.1)
DB_HOST_PORT=3307
# Puerto local de phpMyAdmin (solo 127.0.0.1)
PMA_PORT=8081

# production = errores genéricos; pon APP_DEBUG=true para ver los detalles
APP_ENV=production
APP_DEBUG=false

# true = cualquiera puede crear una cuenta en /register. Ponlo en false cuando ya tengas tus usuarios
# (si no existe ningún usuario, el registro siempre está disponible para crear el primero)
ALLOW_REGISTRATION=true

APP_VERSION=v1.0.0
APP_COMMIT=local
TZ=Europe/Madrid
